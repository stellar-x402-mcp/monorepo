{
  "name": "@stellar-mcp/server",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server for Stellar Horizon and Soroban RPC",
  "bin": {
    "stellar-mcp-server": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=16.2.0 <17.0.0"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "16.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.2",
    "vitest": "^2.1.4"
  }
}
