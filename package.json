{
  "name": "stellar-x402-mcp-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=\"./packages/*\" build",
    "test": "pnpm -r --filter=\"./packages/*\" test",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:all": "pnpm test && pnpm --filter @stellar-mcp/paywalled-oracle test && pnpm --filter @stellar-mcp/trading-agent test && pnpm test:e2e",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  }
}
